# tb710fu-arch-linux: slot-b (locked ABL, GKI v4) boot of the TB710FU
CONFIG_LOCALVERSION="-tb710fu"
# root on a USB-C NVMe/stick: USB storage built in
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
# ABL appends a bootconfig blob after the v4 vendor ramdisk; the kernel must strip it
CONFIG_BOOT_CONFIG=y
CONFIG_BLK_DEV_LOOP=y
# ROOT_DEV=userdata: Android's /data f2fs (casefold, compression, verity) and file
# capabilities (security xattrs) for a root stored on it
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_UNICODE=y
CONFIG_FS_VERITY=y
# built in: Steam Input, gamescope and the Keyboard Pack daemon need /dev/uinput without modprobe
CONFIG_INPUT_UINPUT=y
# the Keyboard Pack UART
CONFIG_SERIAL_QCOM_GENI=y
# keyboard-vdd: L8B switched from userspace (sysfs min/max_microvolts), never at boot
CONFIG_REGULATOR_VIRTUAL_CONSUMER=y
# idle power: TEO picks deeper CPU idle states than menu with tickless timers (build.sh
# CMDLINE selects it: cpuidle.governor=teo; menu stays built as the fallback)
CONFIG_CPU_IDLE_GOV_TEO=y
# zswap: compressed cache in front of the disk swap files. Built in but off by default: with the
# zram swap still configured it would compress twice (docs/KERNEL-BUILD.md, "zswap")
CONFIG_ZSWAP=y
CONFIG_ZSWAP_SHRINKER_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSMALLOC=y
