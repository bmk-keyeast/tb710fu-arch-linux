# tb710fu-arch-linux: slot-b (locked ABL, GKI v4) boot of the TB710FU
CONFIG_LOCALVERSION="-tb710fu"
# root on a USB-C NVMe/stick: USB storage built in
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
# ABL appends a bootconfig blob after the v4 vendor ramdisk; the kernel must strip it
CONFIG_BOOT_CONFIG=y
CONFIG_BLK_DEV_LOOP=y
# ROOT_DEV=userdata: Android's /data f2fs (casefold, compression, verity) and file
# capabilities (security xattrs) for a root stored on it
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_UNICODE=y
CONFIG_FS_VERITY=y
# Keyboard Pack daemon (uinput) and its UART
CONFIG_INPUT_UINPUT=m
CONFIG_SERIAL_QCOM_GENI=y
# keyboard-vdd: L8B switched from userspace (sysfs min/max_microvolts), never at boot
CONFIG_REGULATOR_VIRTUAL_CONSUMER=y
