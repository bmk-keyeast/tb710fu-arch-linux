# TB710FU Arch Linux ARM + KDE Plasma build settings (sourced by build.sh)

# Work/output dir on WSL ext4 (root-owned rootfs needs a real Linux fs)
T="$HOME/tb710fu"
# kernel: armada = ArmadaOS Freedom's unified kernel + kernel/armada-overlay/tb710fu-locked,
# built by .github/workflows/kernel.yml in GH_REPO (build.sh kernel downloads the artifact);
# spendy = the SpendyYT tree in KSRC with build/patches, cross-compiled locally
KERNEL_SRC="${KERNEL_SRC:-armada}"
GH_REPO="bmk-keyeast/tb710fu-arch-linux"
KSRC="$T/tb710fu-linux"
OUT="$T/out"

# Fixed GPT partition UUIDs for the USB NVMe SSD.
# boot.img cmdline (root=) and /etc/fstab (/home) use these; build.sh image / firstboot apply them.
ROOT_PARTUUID="9d53a1f9-76da-45f9-840d-29fec7a13ce6"
HOME_PARTUUID="24b0126b-f991-45ea-bd77-dcae5f5c185f"
ROOT_SIZE="64G"            # SSD p1 = root, p2 = /home (rest of disk)
# root and /home filesystem: ext4 (Android can mount it to repair Linux) or btrfs (snapshots, zstd;
# the Android GKI kernel has no btrfs)
ROOT_FS="${ROOT_FS:-ext4}"   # override per build: ROOT_FS=btrfs build.sh rootfs image

# Where the root lives (only the slot-b payload differs: build.sh v4 e3 -> out/v4/e3 or e3-userdata):
#   ssd       the USB-C SSD partition above
#   userdata  folder ROOT_DIR on Android's /data, sharing its free space. Needs Android's encryption
#             off first (build/fbe-off.py + tb710fu-android-fbe) and the system copied there
#             (tb710fu-install-userdata, run from the SSD boot). /data shows up as /mnt/android.
ROOT_DEV="${ROOT_DEV:-ssd}"
ROOT_DIR="/linux"
case "$ROOT_DEV" in
userdata) ROOT_ARG="root=PARTLABEL=userdata tb710fu.rootdir=$ROOT_DIR" ;;
*) ROOT_ARG="root=PARTUUID=$ROOT_PARTUUID" ;;
esac

# panic=10: reboot on panic so ABL's retry counter can fall back to slot a
# tb710fu.wait: seconds the initramfs waits for the root device before switching to slot a
# regulator_ignore_unused (as ArmadaOS boots it): without it the late regulator cleanup turns off
# rails no driver claimed yet but the bootloader left on - the likely cause of the panel going
# dark a little while after the desktop appeared
CMDLINE="$ROOT_ARG rw rootwait clk_ignore_unused pd_ignore_unused regulator_ignore_unused console=tty0 panic=10 tb710fu.wait=30 cpuidle.governor=teo"

# First user (test password - change it with `passwd` after first boot).
USERNAME="bmk"
PASSWORD="tb710fu"

HOSTNAME="tb710fu"
TIMEZONE="Asia/Seoul"

ALARM_URL="http://os.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz"
PACKAGES="
	zram-generator plasma-desktop plasma-nm plasma-pa powerdevil kscreen bluedevil breeze-gtk
	kde-gtk-config sddm sddm-kcm plasma-keyboard konsole dolphin ark spectacle
	networkmanager bluez bluez-utils pipewire pipewire-pulse wireplumber
	mesa vulkan-freedreno alsa-ucm-conf linux-firmware-qcom linux-firmware-atheros
	noto-fonts noto-fonts-cjk fcitx5-im fcitx5-hangul
	sudo vim git python-evdev btrfs-progs
"

# stock dsp partition image (ADSP libs for the sensor hub), from the Lenovo ROM package
DSPSO="/mnt/c/lenovo/RomFiles/TB710FU_ROW_OPEN_USER_Q00019.0_A16_ZUI_17.5.04.070_ST_260621/TB710FU_ROW_OPEN_USER_Q00019.0_A16_ZUI_17.5.04.070_ST_260621/image/dspso.bin"

TESTKEY_SHA1="2597c218aae470a130f61162feaae70afd97f011"   # AOSP testkey_rsa4096 (LTBox KEY_MAP)
