# TB710FU Arch Linux ARM + KDE Plasma build settings (sourced by build.sh)

# Work/output dir on WSL ext4 (root-owned rootfs needs a real Linux fs)
T="$HOME/tb710fu"
KSRC="$T/tb710fu-linux"
OUT="$T/out"

# Fixed GPT partition UUIDs for the USB NVMe SSD.
# boot.img cmdline (root=) and /etc/fstab (/home) use these; build.sh image / firstboot apply them.
ROOT_PARTUUID="9d53a1f9-76da-45f9-840d-29fec7a13ce6"
HOME_PARTUUID="24b0126b-f991-45ea-bd77-dcae5f5c185f"
ROOT_SIZE="64G"            # SSD p1 = root, p2 = /home (rest of disk)

# panic=10: reboot on panic so ABL's retry counter can fall back to slot a
# tb710fu.wait: seconds the initramfs waits for the root SSD before switching to slot a
CMDLINE="root=PARTUUID=$ROOT_PARTUUID rw rootwait clk_ignore_unused pd_ignore_unused console=tty0 panic=10 tb710fu.wait=30"

# First user (test password - change it with `passwd` after first boot).
USERNAME="bmk"
PASSWORD="tb710fu"

HOSTNAME="tb710fu"
TIMEZONE="Asia/Seoul"

ALARM_URL="http://os.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz"
PACKAGES="
	plasma-desktop plasma-nm plasma-pa powerdevil kscreen bluedevil breeze-gtk
	kde-gtk-config sddm sddm-kcm plasma-keyboard konsole dolphin ark spectacle
	networkmanager bluez bluez-utils pipewire pipewire-pulse wireplumber
	mesa vulkan-freedreno alsa-ucm-conf linux-firmware-qcom linux-firmware-atheros
	noto-fonts noto-fonts-cjk fcitx5-im fcitx5-hangul
	sudo vim git btrfs-progs python-evdev
"

# stock dsp partition image (ADSP libs for the sensor hub), from the Lenovo ROM package
DSPSO="/mnt/c/lenovo/RomFiles/TB710FU_ROW_OPEN_USER_Q00019.0_A16_ZUI_17.5.04.070_ST_260621/TB710FU_ROW_OPEN_USER_Q00019.0_A16_ZUI_17.5.04.070_ST_260621/image/dspso.bin"

TESTKEY_SHA1="2597c218aae470a130f61162feaae70afd97f011"   # AOSP testkey_rsa4096 (LTBox KEY_MAP)
