From 42e3b26584f4e4c76533f5bfe57f7a7341409d6f Mon Sep 17 00:00:00 2001
From: YOUR NAME <you@example.com>
Date: Wed, 18 Nov 2026 15:58:36 +0900
Subject: [RFC PATCH 1/2] dt-bindings: input: Add Lenovo TB710FU Keyboard Pack

The Keyboard Pack is a detachable keyboard with a touchpad for the Lenovo
TB710FU tablet (Xiaoxin Pad Pro GT). It connects through pogo pins and
talks to the tablet over a UART.

The binding text was drafted with an AI coding assistant (Claude Opus 5.5)
and reviewed by the submitter.
---
 .../input/lenovo,tb710fu-keyboard-pack.yaml   | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/lenovo,tb710fu-keyboard-pack.yaml

diff --git a/Documentation/devicetree/bindings/input/lenovo,tb710fu-keyboard-pack.yaml b/Documentation/devicetree/bindings/input/lenovo,tb710fu-keyboard-pack.yaml
new file mode 100644
index 000000000..6ffe53098
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/lenovo,tb710fu-keyboard-pack.yaml
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/lenovo,tb710fu-keyboard-pack.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Lenovo TB710FU Keyboard Pack
+
+maintainers:
+  - YOUR NAME <you@example.com>
+
+description:
+  Detachable keyboard with a touchpad for the Lenovo TB710FU tablet. It connects
+  through pogo pins and talks to the tablet over a UART at 921600 baud.
+
+allOf:
+  - $ref: /schemas/serial/serial-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: lenovo,tb710fu-keyboard-pack
+
+  vdd-supply:
+    description: Supply of the pogo pins, enabled while a keyboard is attached.
+
+  tx-enable-gpios:
+    maxItems: 1
+    description: Enables the buffer on the host transmit line.
+
+required:
+  - compatible
+  - vdd-supply
+  - tx-enable-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    serial {
+        keyboard {
+            compatible = "lenovo,tb710fu-keyboard-pack";
+            vdd-supply = <&vreg_l8b_1p8>;
+            tx-enable-gpios = <&tlmm 100 GPIO_ACTIVE_HIGH>;
+        };
+    };
