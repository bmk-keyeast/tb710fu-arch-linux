--- a/hexagonrpcd/hexagonfs_mapped.c
+++ b/hexagonrpcd/hexagonfs_mapped.c
@@ -22,6 +22,7 @@
 #include <dirent.h>
 #include <errno.h>
 #include <fcntl.h>
+#include <stdio.h>
 #include <unistd.h>
 #include <stdbool.h>
 #include <stdlib.h>
@@ -126,6 +127,92 @@ err:
 	return ret;
 }
 
+static int mapped_openat_write(struct hexagonfs_fd *dir, const char *segment, int flags,
+			       struct hexagonfs_fd **out)
+{
+	struct mapped_ctx *dir_ctx = dir->data;
+	struct hexagonfs_fd *fd;
+	struct mapped_ctx *ctx;
+	int ret;
+
+	ctx = malloc(sizeof(struct mapped_ctx));
+	if (ctx == NULL)
+		return -ENOMEM;
+
+	fd = malloc(sizeof(struct hexagonfs_fd));
+	if (fd == NULL) {
+		ret = -ENOMEM;
+		goto err;
+	}
+
+	ctx->fd = openat(dir_ctx->fd, segment, flags | O_CLOEXEC, 0644);
+	if (ctx->fd == -1) {
+		ret = -errno;
+		goto err_free_fd;
+	}
+
+	ctx->dir = NULL;
+
+	fd->is_assigned = false;
+	fd->up = dir;
+	fd->ops = &hexagonfs_mapped_ops;
+	fd->data = ctx;
+
+	*out = fd;
+
+	return 0;
+
+err_free_fd:
+	free(fd);
+err:
+	free(ctx);
+	return ret;
+}
+
+static ssize_t mapped_write(struct hexagonfs_fd *fd, size_t size, const void *ptr)
+{
+	struct mapped_ctx *ctx = fd->data;
+	ssize_t ret;
+
+	ret = write(ctx->fd, ptr, size);
+	if (ret < 0)
+		return -errno;
+
+	return ret;
+}
+
+static int mapped_truncate(struct hexagonfs_fd *fd, off_t len)
+{
+	struct mapped_ctx *ctx = fd->data;
+
+	return ftruncate(ctx->fd, len) ? -errno : 0;
+}
+
+static int mapped_unlinkat(struct hexagonfs_fd *dir, const char *segment)
+{
+	struct mapped_ctx *ctx = dir->data;
+
+	return unlinkat(ctx->fd, segment, 0) ? -errno : 0;
+}
+
+static int mapped_mkdirat(struct hexagonfs_fd *dir, const char *segment, mode_t mode)
+{
+	struct mapped_ctx *ctx = dir->data;
+
+	if (mkdirat(ctx->fd, segment, mode & 0777) && errno != EEXIST)
+		return -errno;
+
+	return 0;
+}
+
+static int mapped_renameat(struct hexagonfs_fd *olddir, const char *oldseg,
+			   struct hexagonfs_fd *newdir, const char *newseg)
+{
+	struct mapped_ctx *o = olddir->data, *n = newdir->data;
+
+	return renameat(o->fd, oldseg, n->fd, newseg) ? -errno : 0;
+}
+
 static ssize_t mapped_read(struct hexagonfs_fd *fd, size_t size, void *out)
 {
 	struct mapped_ctx *ctx = fd->data;
@@ -330,6 +417,12 @@ struct hexagonfs_file_ops hexagonfs_mapped_ops = {
