diff --git a/hexagonrpcd/hexagonfs.c b/hexagonrpcd/hexagonfs.c
index bd9f353..d0de58c 100644
--- a/hexagonrpcd/hexagonfs.c
+++ b/hexagonrpcd/hexagonfs.c
@@ -244,6 +244,158 @@ ssize_t hexagonfs_read(struct hexagonfs_fd **fds, int fileno, size_t size, void
 	return fd->ops->read(fd, size, ptr);
 }
 
+/* open name's parent directory; *base points at the last segment. Returns its file number. */
+static int open_parent(struct hexagonfs_fd **fds, int rootfd, const char *name,
+		       const char **base)
+{
+	const char *slash = strrchr(name, '/');
+	char *parent;
+	int ret;
+
+	if (slash == NULL || slash[1] == '\0')
+		return -EINVAL;
+
+	parent = strndup(name, slash - name + 1);
+	if (parent == NULL)
+		return -ENOMEM;
+
+	ret = hexagonfs_openat(fds, rootfd, rootfd, parent);
+	free(parent);
+	*base = slash + 1;
+
+	return ret;
+}
+
+int hexagonfs_open_write(struct hexagonfs_fd **fds, int rootfd, const char *name, int flags)
+{
+	struct hexagonfs_fd *dir, *fd;
+	const char *base;
+	int dirno, ret;
+
+	dirno = open_parent(fds, rootfd, name, &base);
+	if (dirno < 0)
+		return dirno;
+
+	dir = fds[dirno];
+	if (dir->ops->openat_write == NULL) {
+		hexagonfs_close(fds, dirno);
+		return -EROFS;
+	}
+
+	/* the directory lives on as the new file's (unassigned) parent */
+	fds[dirno] = NULL;
+	dir->is_assigned = false;
+
+	ret = dir->ops->openat_write(dir, base, flags, &fd);
+	if (ret) {
+		destroy_file_descriptor(dir);
+		return ret;
+	}
+
+	ret = allocate_file_number(fds, fd);
+	if (ret < 0)
+		destroy_file_descriptor(fd);
+
+	return ret;
+}
+
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size, const void *ptr)
+{
+	struct hexagonfs_fd *fd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+
+	if (fd->ops->write == NULL)
+		return -EROFS;
+
+	return fd->ops->write(fd, size, ptr);
+}
+
+int hexagonfs_ftruncate(struct hexagonfs_fd **fds, int fileno, off_t len)
+{
+	struct hexagonfs_fd *fd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+
+	if (fd->ops->truncate == NULL)
+		return -EROFS;
+
+	return fd->ops->truncate(fd, len);
+}
+
+int hexagonfs_unlink(struct hexagonfs_fd **fds, int rootfd, const char *name)
+{
+	const char *base;
+	int dirno, ret;
+
+	dirno = open_parent(fds, rootfd, name, &base);
+	if (dirno < 0)
+		return dirno;
+
+	if (fds[dirno]->ops->unlinkat == NULL)
+		ret = -EROFS;
+	else
+		ret = fds[dirno]->ops->unlinkat(fds[dirno], base);
+
+	hexagonfs_close(fds, dirno);
+	return ret;
+}
+
+int hexagonfs_mkdir(struct hexagonfs_fd **fds, int rootfd, const char *name, mode_t mode)
+{
+	const char *base;
+	int dirno, ret;
+
+	dirno = open_parent(fds, rootfd, name, &base);
+	if (dirno < 0)
+		return dirno;
+
+	if (fds[dirno]->ops->mkdirat == NULL)
+		ret = -EROFS;
+	else
+		ret = fds[dirno]->ops->mkdirat(fds[dirno], base, mode);
+
+	hexagonfs_close(fds, dirno);
+	return ret;
+}
+
+/* both names in host-mapped directories (in practice the registry dir) */
+int hexagonfs_rename(struct hexagonfs_fd **fds, int rootfd, const char *oldname,
+		     const char *newname)
+{
+	const char *oldbase, *newbase;
+	int olddir, newdir, ret;
+
+	olddir = open_parent(fds, rootfd, oldname, &oldbase);
+	if (olddir < 0)
+		return olddir;
+
+	newdir = open_parent(fds, rootfd, newname, &newbase);
+	if (newdir < 0) {
+		hexagonfs_close(fds, olddir);
+		return newdir;
+	}
+
+	if (fds[olddir]->ops->renameat == NULL || fds[olddir]->ops != fds[newdir]->ops)
+		ret = -EROFS;
+	else
+		ret = fds[olddir]->ops->renameat(fds[olddir], oldbase, fds[newdir], newbase);
+
+	hexagonfs_close(fds, newdir);
+	hexagonfs_close(fds, olddir);
+	return ret;
+}
+
 int hexagonfs_readdir(struct hexagonfs_fd **fds, int fileno, size_t ent_size, char *ent)
 {
 	struct hexagonfs_fd *fd;
