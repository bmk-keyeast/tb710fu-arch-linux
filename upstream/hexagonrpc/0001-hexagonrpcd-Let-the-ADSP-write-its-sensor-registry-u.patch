+		.impl = apps_std_fremove,
+	},
 	{ .def = NULL, .impl = NULL, },
 	{
 		.def = &apps_std_opendir_def,
@@ -459,16 +627,27 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 		.def = &apps_std_readdir_def,
 		.impl = apps_std_readdir,
 	},
-	{ .def = NULL, .impl = NULL, },
