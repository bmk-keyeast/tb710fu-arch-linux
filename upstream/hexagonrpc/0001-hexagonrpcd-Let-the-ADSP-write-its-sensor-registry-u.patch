@@ -20,6 +20,8 @@
  */
 
 #include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
 #include <libhexagonrpc/error.h>
 #include <stdio.h>
 #include <stdint.h>
@@ -150,6 +152,143 @@ static uint32_t apps_std_fseek(void *data,
 	return 0;
 }
 
+/* the only writable place: the sensor registry under persist (mapped to the host) */
+static bool persist_path(const char *name)
+{
+	return !strncmp(name, "/mnt/vendor/persist/", 20) || !strncmp(name, "/persist/", 9);
+}
+
+static uint32_t apps_std_fwrite(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const struct {
+		uint32_t fd;
+		uint32_t buf_size;
+	} *first_in = inbufs[0].p;
+	struct {
+		uint32_t written;
+		uint32_t is_eof;
+	} *first_out = outbufs[0].p;
+	ssize_t ret;
+
+	ret = hexagonfs_write(ctx->fds, first_in->fd, inbufs[1].s, inbufs[1].p);
+	if (ret < 0) {
+		fprintf(stderr, "Could not write file: %s\n", strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+	first_out->written = ret;
+	first_out->is_eof = 0;
+
+	return 0;
+}
+
+/* writes are plain write(2)s; the registry is small, so no fsync either */
+static uint32_t apps_std_fsync(void *data,
+			       const struct fastrpc_io_buffer *inbufs,
+			       struct fastrpc_io_buffer *outbufs)
+{
+	return 0;
+}
+
+static uint32_t apps_std_fremove(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const char *name = inbufs[1].p;
+	int ret;
+
+	if (inbufs[1].s == 0 || name[inbufs[1].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	if (!persist_path(name))
+		return AEE_EUNSUPPORTED;
+
+	ret = hexagonfs_unlink(ctx->fds, ctx->rootfd, name);
+	if (ret && ret != -ENOENT) {
+		fprintf(stderr, "Could not remove %s: %s\n", name, strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+	return 0;
+}
+
+static uint32_t apps_std_mkdir(void *data,
+			       const struct fastrpc_io_buffer *inbufs,
+			       struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const struct {
+		uint32_t name_len;
+		uint32_t mode;
+	} *first_in = inbufs[0].p;
+	const char *name = inbufs[1].p;
+	int ret;
+
+	if (inbufs[1].s == 0 || name[inbufs[1].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	if (!persist_path(name))
+		return AEE_EUNSUPPORTED;
+
+	ret = hexagonfs_mkdir(ctx->fds, ctx->rootfd, name, first_in->mode);
+	if (ret) {
+		fprintf(stderr, "Could not mkdir %s: %s\n", name, strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+	return 0;
+}
+
+static uint32_t apps_std_ftrunc(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const struct {
+		uint32_t fd;
+		uint32_t len;
+	} *first_in = inbufs[0].p;
+	int ret;
+
+	ret = hexagonfs_ftruncate(ctx->fds, first_in->fd, first_in->len);
+	if (ret) {
+		fprintf(stderr, "Could not truncate: %s\n", strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+	return 0;
+}
+
+/* the registry is updated by writing fstempfile and renaming it over the target */
+static uint32_t apps_std_frename(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const char *oldname = inbufs[1].p, *newname = inbufs[2].p;
+	int ret;
+
+	if (inbufs[1].s == 0 || oldname[inbufs[1].s - 1] != 0
+	 || inbufs[2].s == 0 || newname[inbufs[2].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	if (!persist_path(oldname) || !persist_path(newname))
+		return AEE_EUNSUPPORTED;
+
+	ret = hexagonfs_rename(ctx->fds, ctx->rootfd, oldname, newname);
+	if (ret) {
+		fprintf(stderr, "Could not rename %s to %s: %s\n",
+				oldname, newname, strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+	return 0;
+}
+
 static uint32_t apps_std_fopen_with_env(void *data,
 					const struct fastrpc_io_buffer *inbufs,
 					struct fastrpc_io_buffer *outbufs)
@@ -166,10 +305,30 @@ static uint32_t apps_std_fopen_with_env(void *data,
 		return AEE_EBADPARM;
 
 	rw_mode = ((const char *) inbufs[4].p)[0];
-	if (rw_mode == 'w' || rw_mode == 'a') {
-		fprintf(stderr, "Tried to open %s for writing\n",
-				(const char *) inbufs[3].p);
-		return AEE_EUNSUPPORTED;
+	if (rw_mode == 'w' || rw_mode == 'a' || strchr(inbufs[4].p, '+')) {
+		const char *name = inbufs[3].p;
+		int flags;
+
+		if (!persist_path(name)) {
+			fprintf(stderr, "Tried to open %s for writing\n", name);
+			return AEE_EUNSUPPORTED;
+		}
+
+		flags = strchr(inbufs[4].p, '+') ? O_RDWR : O_WRONLY;
+		if (rw_mode == 'w')
+			flags |= O_CREAT | O_TRUNC;
+		else if (rw_mode == 'a')
+			flags |= O_CREAT | O_APPEND;
+
+		fd = hexagonfs_open_write(ctx->fds, ctx->rootfd, name, flags);
+		if (fd < 0) {
+			fprintf(stderr, "Could not open %s for writing: %s\n",
+					name, strerror(-fd));
+			return AEE_EFAILED;
+		}
+
+		*out = fd;
+		return 0;
 	}
 
 	if (!strcmp(inbufs[1].p, "ADSP_LIBRARY_PATH")) {
@@ -420,7 +579,10 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 		.def = &apps_std_fread_def,
 		.impl = apps_std_fread,
 	},
-	{ .def = NULL, .impl = NULL, },
